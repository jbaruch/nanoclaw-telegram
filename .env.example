# Repository secrets are managed in GitHub Actions:
# https://github.com/jbaruch/nanoclaw/settings/secrets/actions
#
# This file groups variables by where they are consumed. CI-only
# secrets are read by the policy-review workflows in
# .github/workflows/ and never touch the runtime; runtime secrets are
# read from `.env` on the NAS by `src/ipc.ts` and similar production
# code paths and never appear in CI.

# ----- CI-only secrets -------------------------------------------------

# OpenAI-family billing for the Codex-engine policy reviewer
# (.github/workflows/review-openai.lock.yml). The reviewer reads
# CODEX_API_KEY or OPENAI_API_KEY — CODEX_API_KEY wins when both are set.
CODEX_API_KEY=
OPENAI_API_KEY=sk-...

# Anthropic billing account for the Claude Code policy reviewer
# (.github/workflows/review-anthropic.lock.yml).
ANTHROPIC_API_KEY=sk-ant-...

# tessl install authentication for fetching jbaruch/coding-policy at
# review time. Create at https://tessl.io/account/api-keys.
TESSL_TOKEN=...

# ----- Runtime secrets -------------------------------------------------

# ----- Runtime inference auth (choose ONE mode) -----------------------
#
# Agent containers reach Anthropic through the host credential-proxy
# (`src/credential-proxy.ts`), which auto-detects the auth mode from the
# vars below. Set EXACTLY ONE mode.
#
# Either way the proxy forwards to api.anthropic.com — there is no
# gateway or custom endpoint in the request path.
#
# Mode A — API key (metered, pay-per-token via Claude Console):
#   Set ANTHROPIC_API_KEY on the NAS `.env` (the same var name the
#   CI-only block above documents doubles as the runtime key on the
#   box). The proxy runs in `api-key` mode and injects `x-api-key`.
#
# Mode B — Subscription OAuth (flat-fee Pro/Max/Team/Enterprise plan):
#   Set CLAUDE_CODE_OAUTH_TOKEN and LEAVE ANTHROPIC_API_KEY UNSET
#   (its presence is what selects api-key mode). The proxy runs in
#   `oauth` mode: the in-container CLI exchanges a placeholder token for
#   a temp API key via `/api/oauth/claude_cli/create_api_key`, and the
#   proxy injects the real OAuth token on that one exchange request.
#   Generate the token on any machine already logged into the plan:
#
#       claude setup-token
#
#   It prints a long-lived (~1yr) token built for headless/CI use. Paste
#   it as the value on the NAS `.env` only; never commit it.
#
#   A flat-fee plan has no per-token dollar meter, but the usage wiretap
#   (`usage.jsonl`) still logs token COUNTS (it parses the response
#   body, not billing), so token-level visibility survives in Mode B.
#
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Composio — ONE project key (`ak_*`), TWO surfaces. The project-scoped
# `ak_*` key authenticates both surfaces below via `x-api-key`. The
# consumer "Connect" MCP gateway (`connect.composio.dev/mcp`) moved to
# interactive AuthKit-JWT OAuth and can't run unattended, so the old
# `ck_*` COMPOSIO_MCP_KEY is retired — both surfaces now share `ak_*`.
#
#   COMPOSIO_API_KEY  — `x-api-key` for BOTH:
#                       (1) REST `https://backend.composio.dev/api/v3/...`
#                           — read by the inline-fetch precheck in
#                           `tessl__composio-fetch` (admin tile) so the
#                           30-min fetch runs as a deterministic script
#                           without waking the LLM.
#                       (2) the headless custom MCP server below.
#                       Project-scoped key, `ak_*` prefix.
#   COMPOSIO_MCP_URL  — URL of a Composio *custom MCP server* (created
#                       via `POST /api/v3.1/mcp/servers`, bound to the
#                       gmail/calendar/tasks auth configs + the `composio`
#                       no-auth toolkit). Form:
#                       `https://backend.composio.dev/v3/mcp/<id>/mcp`
#                       (no query string — the agent runner appends
#                       `?user_id=$COMPOSIO_USER_ID`). Read by the agent
#                       runner's MCP registration
#                       (`container/agent-runner/src/index.ts`) so
#                       `mcp__composio__*` tools authenticate headlessly.
#                       The embedded server id is account-identifying, so
#                       it routes through the secret env-file like the key.
#
# Both forwarded into agent containers (main + trusted only) via the
# CONTAINER_VARS list in `src/container-runner.ts` and routed through
# the secret env-file (mode 0600) per `SECRET_CONTAINER_VARS`. Untrusted
# groups never receive either value.
COMPOSIO_API_KEY=ak_...
COMPOSIO_MCP_URL=https://backend.composio.dev/v3/mcp/<server-id>/mcp

# Composio user_id bound to the connected accounts in the project the
# COMPOSIO_API_KEY authenticates against. Not a credential per se —
# identifies WHICH user's Gmail/Calendar/GitHub connections to act on
# — but treated as account-identifying so it routes through the same
# secret env-file as the keys (#509). Required by the inline-fetch
# precheck; without it the precheck disables the inline path and the
# LLM-side MCP fallback runs instead.
COMPOSIO_USER_ID=...

# Fine-grained GitHub PAT consumed in TWO places:
#
#   1. Host-side `github_backup` IPC handler at `src/ipc.ts`
#      (case 'github_backup') — pushes the backup branch on
#      `jbaruch/nanoclaw`. Read at runtime via
#      `readEnvFile(['GITHUB_TOKEN'])`; injected into `git push`
#      ephemerally as `GIT_CONFIG_KEY_0` so it never lives in any
#      group's `backup-repo/.git/config` (cleaned up by
#      `scripts/clean-backup-repo-origins.sh` per #399).
#
#   2. Container-side `gh` CLI inside main/trusted-tier containers —
#      forwarded by `src/container-runner.ts` via the per-spawn
#      `--env-file` (`SECRET_CONTAINER_VARS`). Used by the cost-monitor
#      dashboard skills (`precheck-gating-monitor`,
#      `session-cap-monitor`, `daily-spend-rollup`) to run
#      `gh issue list/edit/comment` against the dashboard issues
#      directly, avoiding Composio's MCP GitHub tool-schema cache_create
#      tax on every cold maintenance spawn. `gh` reads `GITHUB_TOKEN`
#      automatically — no in-container `gh auth login` needed.
#
# Scope required for BOTH use sites: `Contents: write` (host git push)
# + `Issues: write` + `Pull requests: write` (container `gh` issue
# operations), all restricted to `jbaruch/nanoclaw` — no admin
# scopes, no other repos. Operator expanding from the previous
# "Contents: write only" scope to add the two new ones is a one-time
# action when this PR's container image rolls out; the dashboards in
# `jbaruch/nanoclaw` (#560 / #561 / #562) won't update otherwise.
#
# Create at https://github.com/settings/personal-access-tokens/new and
# rotate the value here whenever GitHub flags the token as expiring.
#
# OneCLI migration: tracked in jbaruch/nanoclaw#564 — when the OneCLI
# proxy lands, the container forward goes away and only the host-side
# `github_backup` use-site keeps reading this directly.
GITHUB_TOKEN=github_pat_...

# ----- OneCLI Agent Vault (jbaruch/nanoclaw#564 groundwork) ------------
#
# When BOTH variables are set, the orchestrator registers tier-scoped
# agents at startup and mutates each container's docker spawn args to
# add HTTPS_PROXY env + mount the OneCLI CA bundle + add the
# host.docker.internal mapping. Unset both to leave the spawn path
# untouched (current behavior).
#
# `ONECLI_URL` — host-reachable gateway base URL (e.g.
#   `http://host.docker.internal:10254` when OneCLI runs on the NAS host).
# `ONECLI_API_KEY` — `oc_*` project key or `oc_org_*` org key minted from
#   the OneCLI dashboard. Read at startup; no per-container forwarding.
#
# Stage 1 caveat: setting these two now does NOT remove real credentials
# from containers. Until #637 (Anthropic/OpenAI swap) and #640 (rest of
# the `.env` keys) land, `SECRET_CONTAINER_VARS` is still forwarded via
# the per-spawn `--env-file`. The endpoint "containers never see real
# keys" is reached only after the full umbrella #564 completes.
#
# Operational install (#636) ships separately from this groundwork
# (#635). Until then, leave both unset.
ONECLI_URL=
ONECLI_API_KEY=

# ----- Runtime config (non-secret) -------------------------------------
#
# Non-secret tunables consumed by the orchestrator at startup
# (`src/config.ts`). These are configuration, not credentials —
# documented here per `rules/no-secrets.md` so a new maintainer can
# see the full set of env-driven knobs in one place. Repository
# secrets are still managed at the link in the file header above.

# Session-length cap (#413). Forces a session reset (new SDK
# session_id + brief context handoff) when one of the cumulative
# thresholds below is crossed AFTER an assistant turn completes —
# the actual reset fires on the NEXT inbound message so the current
# turn is never yanked mid-flight. Distinct from the per-turn
# kill-auto-compaction nuke (`ENABLE_THRESHOLD_NUKE`), which fires
# only when a single turn's `usage.input_tokens` crosses a percentage
# of the model context window. Without these cumulative caps a single
# session can balloon to multi-million-token `cache_read` (issue body
# cites >18M `cache_read` in one query). Set <= 0 to disable a
# specific threshold without disabling the other; both <= 0 disables
# the feature entirely.
#
# SESSION_TOKEN_CAP=1000000  # default; sum of input_tokens across all turns
# SESSION_TURN_CAP=100       # default; number of assistant turns observed
#
# These two are the GLOBAL caps — one knob shared by every group, so it
# must cover the busiest group. A quiet group can pin a tighter cap of
# its own (freeing context and dropping maintenance spend sooner) via the
# per-group `containerConfig.sessionTurnCap` / `sessionTokenCap` override
# (#561), set with the `set_session_caps` IPC / MCP tool. A positive
# per-group value wins; absent/invalid inherits the global above.
# Disabling a cap stays a global-only operation (set <= 0 here).

# Maintenance-session blocklists (#337). Filter the per-spawn install
# loop in `src/container-runner.ts` when `sessionName === 'maintenance'`
# (heartbeat fires, scheduled-task fires, owner reminders that fall
# into the maintenance slot): drop the listed rules and skills from
# the container's aggregated `.tessl/RULES.md` and `skills/` tree
# before the SDK reads them. Bytes saved compound across every
# cold-start session — pre-#337 baseline showed a ~93% drop in
# heartbeat duration with the round-1 blocklist applied (#349 verdict
# 2026-05-07: "Win — tighten").
#
# Empty / unset = no filter (regression-safe default). Inbound user
# messages route to `sessionName === 'default'` and bypass these.
#
# Format: comma-separated names, no whitespace required around commas.
#   RULE entries are filenames as they appear under
#     `tiles/<owner>/<tile>/rules/`, e.g. `skill-authoring.md`.
#   SKILL entries are bare directory names — no `tessl__` prefix; the
#     orchestrator adds it at copy-into-container time.
#
# Tightening rounds:
#   Round 1 (#337 / PR #344, deployed 2026-04-30): originally the
#     9 rules + 28 skills documented in #337's first cut. PR #533
#     (2026-05-08) trimmed eight broken entries from the skill
#     list after a deeper audit covering SKILL.md + `references/`
#     + `scripts/` (the surfaces #337's pre-deploy validation
#     missed) found that cadence-registered maintenance skills
#     were actively invoking the blocklisted skills via `Skill()`
#     and silently no-op-ing because the skill files were absent
#     from the maintenance container per `container-runner.ts:1763`.
#     The eight removed: `audible-backup`, `check-cfps`,
#     `check-orders`, `check-travel-bookings`, `check-watchlist`,
#     `recommend-books`, `recommend-shows`, `soul-searching`. The
#     calling fires were `entertainment-sync` (Sundays — 0 actual
#     runs since deploy, bug latent), `nightly-external-sync`
#     (daily 08:45 UTC — 4 runs, durations 158s/4s/60s/56s
#     suggesting silent no-ops on the 4s run), `check-watchlist`'s
#     own daily cadence (4 runs, 63s/27s/4s/4s — the two ~4s runs
#     mark silent no-ops), and `soul-searching-wrapper` (Sundays —
#     0 runs, latent). All four marked `success` in `task_run_logs`
#     because no exception was thrown — `HEARTBEAT-CRASH:` is
#     heartbeat-specific and didn't surface failures in other
#     cadence skills, so #349's verdict missed the bug entirely.
#     Round-1 final shape: 9 rules + 20 skills below.
#   Round 2 (#349 verdict tighten action, deployed 2026-05-08
#     after the deeper-audit method from PR #533): adds
#     `check-calendar`, `check-email`, `check-system-health`,
#     `trusted-memory` to the skill list. The original #531 attempt
#     was pulled in #532 because the audit method then was too
#     shallow; the same four candidates re-cleared the deeper
#     method (`SKILL.md` + `references/` + `scripts/` across the
#     full maintenance skill tree, plus group `CLAUDE.md` /
#     `SOUL.md` / `MEMORY.md`, plus `scheduled_tasks.prompt`):
#     zero `Skill()` invocations from any cadence-registered
#     maintenance skill, zero references in group instructions,
#     zero operator-scheduled task prompts mentioning the names.
#     The only matches across all surfaces are two doc-comment
#     lines in `tessl__heartbeat/scripts/heartbeat-precheck.py`
#     listing `check-email` and `trusted-memory` as other writers
#     to a shared state file (race-safety follow-up note, not
#     active invocations). The "use as part of heartbeat or
#     standalone" wording in the standalone `check-email` /
#     `check-calendar` SKILL.md descriptions is aspirational —
#     heartbeat does the work inline today via
#     `references/email-triage.md` and the SKILL.md's own
#     Calendar section. If a future refactor converges
#     heartbeat onto the standalone skills, this blocklist line
#     is the visible artifact that has to be touched in the same
#     PR.
#
# Validation after edit: redeploy and tail
# `groups/<group>/memory/daily/$(date -u +%Y-%m-%d).md` for the
# next 24 h. A `HEARTBEAT-CRASH:` or `HEARTBEAT: missed-task` entry
# means the blocklist dropped a load-bearing item — pull the
# offender out and redeploy. Per #337's deploy-and-watch pattern;
# no staging environment exists for this repo so the live group is
# the validation surface.

MAINTENANCE_RULE_BLOCKLIST=no-inplace-overrides.md,skill-tile-placement.md,skill-writing-guide.md,context-recovery.md,post-compaction-trust.md,compaction-aware-summaries.md,wiki-awareness.md,daily-discoveries-rule.md,installed-content-immutable.md
MAINTENANCE_SKILL_BLOCKLIST=broadcast-to-chat,create-agent-team,manage-groups,manage-tasks,max-effort,no-unverified-claims,promote-tiles,promote-tiles-architecture,schedule-task,scheduler-timezone,status,system-status,trakt-watch-history,troubleshoot-chat,verify-tiles,check-unanswered,agent-browser,capabilities,session-reentry,wiki,check-calendar,check-email,check-system-health,trusted-memory

# Force the general-purpose subagent definitions to be attached on
# maintenance-session spawns. Default (unset): they are SKIPPED for
# maintenance — those cadence tasks (heartbeat, composio-fetch,
# morning-brief, nightly-*) provably never call Task/TeamCreate, yet the
# definitions ship a large cached agent prompt (every installed skill +
# the full rule chain) that is re-created on every cold cache (the
# short cadences always outlast the prompt-cache TTL). Skipping removes
# the dominant cold-cache cost of those wakes. Set to `1` ONLY if a
# future maintenance task genuinely needs to fan out to a subagent.
# Default/user-facing sessions always get the definitions regardless.
MAINTENANCE_LOAD_SUBAGENTS=

# Prompt-cache TTL extension (#537). By default, telegram_swarm default-session
# main containers upgrade SDK-emitted ephemeral cache breakpoints to 1h.
# Disable with NANOCLAW_PROMPT_CACHE_1H=0/false/no/off or expand the rollout with a
# comma-separated group-folder list (or '*' for all main default-session groups).
# NANOCLAW_PROMPT_CACHE_1H=1
# NANOCLAW_PROMPT_CACHE_1H_GROUPS=telegram_swarm

# Session artifact retention (#538). Before resuming a persisted SDK
# session, prune old/heavy artifacts that otherwise get re-injected on cold
# starts: older inline screenshots are replaced with text stubs, and old large
# tool-result side-file references are stubbed/deleted. Disable with
# SESSION_ARTIFACT_RETENTION=0/false/no/off.
# SESSION_ARTIFACT_RETENTION=1
# SESSION_INLINE_IMAGE_KEEP_RECENT=2
# SESSION_TOOL_RESULT_MAX_BYTES=65536
# SESSION_TOOL_RESULT_MIN_AGE_MS=21600000

# byAir personal MCP link with API key inline. Used by the
# `jbaruch/nanoclaw-travel` per-chat overlay tile's precheck to
# poll flight status via the byAir streamable-HTTP endpoint. Get from
# https://byairapp.com/mcp/ (Pro subscription required). Rotate in-app
# if exposed.
BYAIR_MCP_URL=https://api.byairapp.com/mcp?api_key=byair_...

# Google Maps Distance Matrix API key for traffic-aware time-to-leave
# in the nanoclaw-travel tile. Generate at
# https://console.cloud.google.com/apis/credentials with the Distance
# Matrix API enabled on a billing-attached project. ~$10/1000 requests
# under realistic usage; well within Google's $200/mo free credit.
GOOGLE_MAPS_API_KEY=AIzaSy...

# TomTom Routing/Search API key for the `jbaruch/nanoclaw-travel` tile —
# `maps_client.py` uses TomTom geocode + calculateRoute (api.tomtom.com)
# as the backup behind Google Maps, and the `drive-planner` skill routes
# through it. Generate at https://developer.tomtom.com (free tier ~2,500
# requests/day). Forwarded into main/trusted containers.
TOMTOM_API_KEY=...

# YouTube Data API v3 key for the admin tile's `youtube-comment-check`
# skill. Composio's YouTube toolkit has no comment-threads tool, so the
# skill calls the native API (commentThreads.list + videos.list)
# directly (jbaruch/nanoclaw-admin#339). Generate at
# https://console.cloud.google.com/apis/credentials with "YouTube Data
# API v3" enabled on the project. Forwarded into main/trusted containers.
YOUTUBE_API_KEY=AIzaSy...

# Sessionize API keys for the `jbaruch/nanoclaw-conferences` tile's
# deterministic check-cfps pipeline. Both forwarded into main/trusted
# containers via the secret env-file (SECRET_CONTAINER_VARS).
#
# Speaker-profile key — `discover-open-cfps.py` calls
# GET https://sessionize.com/api/universal/open-cfps for open-CFP
# discovery (jbaruch/nanoclaw-conferences#9). Generate at Sessionize →
# Speaker Profile → API / Integrations. NOT the same as the event key —
# the event key returns {"error":"API key is invalid."} on this endpoint.
SESSIONIZE_SPEAKER_KEY=...

# Event API key — `verify-sessionize.py` (in-container) and the
# host-side `sessionize_get_events` IPC handler use it for per-slug
# CFP-deadline verification.
SESSIONIZE_EVENT_API_KEY=...

# Trakt.tv OAuth credentials for the `trakt-watch-history` skill.
#
# Get the app credentials at https://trakt.tv/oauth/applications —
# create a new app with redirect URI `urn:ietf:wg:oauth:2.0:oob`
# (out-of-band, required for the device-code flow). CLIENT_ID is
# public-ish (sent on every request as `trakt-api-key`); CLIENT_SECRET
# is the rotating-grant secret and must never leak.
TRAKT_CLIENT_ID=...
TRAKT_CLIENT_SECRET=...

# Personal OAuth tokens. Run `docker exec -it nanoclaw python3
# /app/scripts/trakt-auth.py` once to populate both via the device-code
# flow — it appends them here on first run, and the runtime fetcher
# (`jbaruch/nanoclaw-admin#293`) rewrites them in place on autorefresh.
# REFRESH_TOKEN is required for the orchestrator's autorefresh path
# (`src/ipc.ts` `fetch_trakt_history` reads it + passes to the script
# on every IPC call); without it, an expired access token forces full
# device-code re-auth.
TRAKT_ACCESS_TOKEN=...
TRAKT_REFRESH_TOKEN=...
