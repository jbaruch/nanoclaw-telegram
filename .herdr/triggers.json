{
  "schema_version": 1,
  "package_roots": [
    ".claude/skills/*",
    "container/agent-runner",
    "container/skills/*",
    "repo-tokens",
    "scripts",
    "setup",
    "src"
  ],
  "package_change_lines": 400,
  "trust_boundary_paths": [
    ".github/workflows/*",
    ".github/fleet-review-enabled",
    ".claude/skills/claw/scripts/claw",
    "container/Dockerfile",
    "container/agent-runner/src/*",
    "groups/global/CLAUDE.md",
    "groups/main/CLAUDE.md",
    "setup/mounts.ts",
    "setup/register.ts",
    "src/channels/telegram.ts",
    "src/config.ts",
    "src/container-runner.ts",
    "src/container-runtime.ts",
    "src/db.ts",
    "src/env.ts",
    "src/group-folder.ts",
    "src/group-queue.ts",
    "src/index.ts",
    "src/ipc.ts",
    "src/mount-security.ts",
    "src/remote-control.ts",
    "src/router.ts",
    "src/sender-allowlist.ts",
    "src/task-scheduler.ts"
  ],
  "cli_spec_paths": [
    ".claude/skills/claw/scripts/claw",
    "scripts/run-migrations.ts",
    "setup/container.ts",
    "setup/groups.ts",
    "setup/index.ts",
    "setup/mounts.ts",
    "setup/register.ts",
    "setup/timezone.ts",
    "src/channels/telegram.ts",
    "src/index.ts"
  ],
  "cli_surface_markers": [
    "ArgumentParser(",
    "add_argument(",
    "case '--",
    "=== '--",
    ".indexOf('--",
    "process.argv[",
    "() => import('./",
    "this.bot.command(",
    "command === '/",
    "trimmed === '/",
    "process.exit(",
    "sys.exit("
  ],
  "user_doc_paths": [
    "README*.md",
    "CHANGELOG.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "CONTRIBUTORS.md",
    ".env.example",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".claude/skills/*/SKILL.md",
    "config-examples/*",
    "container/skills/*/SKILL.md",
    "docs/*",
    "groups/*/CLAUDE.md",
    "repo-tokens/*.md"
  ]
}
