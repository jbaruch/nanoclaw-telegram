# NanoClaw Orchestrator
# Runs the orchestrator (Telegram bot, message router, credential proxy)
# inside a container, spawning sibling agent containers via Docker socket.

# Base pinned by digest (see container/Dockerfile for the rationale) —
# the same `node:24-trixie-slim` digest the agent image uses, kept in
# lock-step so orchestrator and agents share one reviewed Node/Debian
# base. Debian 13 (trixie) → the explicitly-installed python3 below is
# 3.13. Bumped via the `docker` ecosystem in `.github/dependabot.yml`.
FROM node:26-trixie-slim@sha256:715e55e4b84e4bb0ff48e49b398a848f08e55daed8eb6a0ea1839ae53bc57583

# Install Docker CLI, build tools for native modules (better-sqlite3),
# the sqlite3 CLI (used by src/db-dump.ts for `.dump` per-table SQL
# exports — see #397's github_backup pipeline), and GitHub CLI
# (required by scripts/promote-to-tile-repo.sh to open tile-repo PRs
# and summon Copilot review via GraphQL).
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    docker.io \
    python3 \
    make \
    g++ \
    sqlite3 \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y gh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files for caching
COPY package*.json ./

# Install all deps (need devDependencies for tsc, native modules need build tools)
ENV HUSKY=0
RUN npm install

# Copy source and build TypeScript. The root tsconfig is the
# check-everything (noEmit) config gating scripts/ and setup/ too;
# the image compiles src/ only, via the emit-only build config.
COPY src/ ./src/
COPY tsconfig.json tsconfig.build.json ./
RUN npx tsc -p tsconfig.build.json

# Copy container config (skills, build script, Dockerfile for agent image)
COPY container/ ./container/

# Install tessl CLI. The `reclaim-tripit-timezones-sync` CLI moved to the agent
# image (#748 Phase 2/3) — the TripIt → Reclaim sync now runs in-container via
# the OneCLI gateway, so the orchestrator no longer runs it host-side.
#
# Pinned for reproducible orchestrator rebuilds (`coding-policy:
# dependency-management` Pinning); this replaces the previously-unpinned
# install carried over on this line. Renewal is scanner-tracked, not memory:
# `.github/renovate.json`'s `custom.regex` manager watches this `tessl@<version>`
# literal (npm datasource) and opens a bump PR, same mechanism as the agent-image
# globals (#796). Note this is the tessl *CLI* pin — orthogonal to the floating
# tessl *tile* manifests governed by `nanoclaw-host: tessl-version-floating`.
RUN npm install -g tessl@0.92.0 && tessl --version

# Scripts (promote-from-orchestrator, etc.)
COPY scripts/ ./scripts/

# Tessl workspace — tile dependencies tracked in git, installed at deploy time
COPY tessl-workspace/tessl.json /app/tessl-workspace/tessl.json

# Copy group templates (used by registerGroup to create CLAUDE.md for new groups)
COPY groups/main/CLAUDE.md ./groups/main/CLAUDE.md
COPY groups/global/CLAUDE.md ./groups/global/CLAUDE.md
COPY groups/global/CLAUDE-untrusted.md ./groups/global/CLAUDE-untrusted.md
COPY groups/global/SOUL-untrusted.md ./groups/global/SOUL-untrusted.md

# Remove devDependencies after build
RUN npm prune --omit=dev

# Git safe.directory for bind-mounted repos (backup-repo owned by host user)
RUN git config --global --add safe.directory '*'

# Data directories (store/, data/, groups/, logs/) are bind-mounted at runtime.
# The .env file is also mounted at runtime — never baked into the image.

EXPOSE 3001

CMD ["node", "dist/index.js"]
