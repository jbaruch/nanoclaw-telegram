{
  "name": "nanoclaw",
  "version": "1.2.42",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"container/agent-runner/src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"container/agent-runner/src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"container/agent-runner/src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "auth": "tsx src/whatsapp-auth.ts",
    "lint": "eslint --no-ignore --max-warnings=0 src/ container/agent-runner/src/",
    "lint:fix": "eslint --no-ignore --max-warnings=0 src/ container/agent-runner/src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@onecli-sh/sdk": "^0.2.0",
    "better-sqlite3": "13.0.3",
    "cron-parser": "5.5.0",
    "grammy": "^1.46.0",
    "openai": "7.37.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.13.0",
    "eslint-plugin-no-catch-all": "^1.1.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
