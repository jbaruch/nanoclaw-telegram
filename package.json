{
  "name": "nanoclaw",
  "version": "1.2.66",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"setup/**/*.ts\" \"container/agent-runner/src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"setup/**/*.ts\" \"container/agent-runner/src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"setup/**/*.ts\" \"container/agent-runner/src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "auth": "tsx src/whatsapp-auth.ts",
    "lint": "eslint src/ scripts/ setup/ container/agent-runner/src/",
    "lint:fix": "eslint src/ scripts/ setup/ container/agent-runner/src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@onecli-sh/sdk": "^2.1.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "5.5.0",
    "geo-tz": "^8.1.7",
    "grammy": "^1.39.3",
    "https-proxy-agent": "^7.0.6",
    "openai": "^6.33.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "eslint": "^9.35.0",
    "eslint-plugin-no-catch-all": "^1.1.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "{src,scripts,setup,container/agent-runner/src}/**/*.ts": "prettier --write"
  }
}
